# Helper script for cmake validation tests.
# Removes the build directory to ensure a clean configure, then runs cmake.
# The build directory is preserved after the run for artifact inspection.

# Remove stale build directory if it exists
if(EXISTS "${TEST_BUILD_DIR}")
  file(REMOVE_RECURSE "${TEST_BUILD_DIR}")
endif()

# Run cmake configure
execute_process(
  COMMAND @CMAKE_COMMAND@ -B ${TEST_BUILD_DIR} ${TEST_CMAKE_ARGS} ${TEST_EXTRA_ARGS} -S ${TEST_SOURCE_DIR}
  RESULT_VARIABLE result
  OUTPUT_VARIABLE output
  ERROR_VARIABLE error
)

if(output)
  message(STATUS "${output}")
endif()
if(error)
  message(STATUS "${error}")
endif()

if(NOT result EQUAL 0)
  message(FATAL_ERROR "CMake configure failed with exit code: ${result}")
endif()
